digraph Replicator {
  graph [
    rankdir="LR",
    bgcolor="#f4f1e8",
    pad="0.55",
    nodesep="0.38",
    ranksep="0.7",
    fontname="Arial Bold",
    label="REPLICATOR  /  PRODUCTION ARCHITECTURE",
    labelloc="t",
    labeljust="l",
    fontsize="26",
    fontcolor="#0b0b0b",
    splines="spline"
  ];

  node [
    shape=box,
    style="filled",
    fillcolor="#fffdf7",
    color="#0b0b0b",
    penwidth="2.2",
    fontcolor="#0b0b0b",
    fontname="Arial Bold",
    fontsize="12",
    margin="0.2,0.15"
  ];

  edge [
    color="#5943ff",
    penwidth="2.8",
    arrowsize="0.8",
    fontcolor="#5943ff",
    fontname="Arial Bold",
    fontsize="9"
  ];

  UI [label="01  RESEARCHER\nPaper URL + guardrails", fillcolor="#baff32"];
  API [label="02  CLOUD RUN API\nMission control + SSE", fillcolor="#5943ff", fontcolor="#ffffff"];
  FS [label="FIRESTORE\nDurable state + repair memory", shape=cylinder];
  PS [label="03  PUB/SUB\nAuthenticated async dispatch", shape=cylinder];
  A [label="04  SIX ADK AGENTS\nRead · plan · build · run · verify · report", fillcolor="#0b0b0b", fontcolor="#ffffff"];
  M [label="GEMINI 3.5 FLASH\nStructured scientific reasoning", fillcolor="#5943ff", fontcolor="#ffffff"];
  J [label="05  CLOUD RUN JOBS\nIsolated budget-capped experiments", fillcolor="#0b0b0b", fontcolor="#ffffff"];
  G [label="06  CLOUD STORAGE\nImmutable code + logs + metrics", shape=cylinder];
  V [label="07  VERIFIER\nClaim ↔ observed measurement"];
  O [label="08  SIGNED REPORT\nAuditable evidence verdict", fillcolor="#baff32"];

  UI -> API;
  API -> PS;
  PS -> A;
  A -> J [color="#baff32", fontcolor="#507a00"];
  J -> G [color="#baff32", fontcolor="#507a00"];
  G -> V [color="#baff32", fontcolor="#507a00"];
  V -> O [color="#baff32", fontcolor="#507a00"];

  API -> FS [style=dashed, constraint=false];
  FS -> A [style=dashed, constraint=false];
  A -> M [dir=both, style=dashed, constraint=false];
}
