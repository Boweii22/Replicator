digraph Replicator {
  graph [bgcolor="#07100d", pad="0.4", nodesep="0.5", ranksep="0.7", fontname="Arial", label="REPLICATOR · EVIDENCE-FIRST AUTONOMOUS SCIENCE", labelloc="t", fontsize="20", fontcolor="#e8f1eb"];
  node [shape=box, style="rounded,filled", fillcolor="#10251e", color="#315043", fontcolor="#e8f1eb", fontname="Arial", margin="0.18"];
  edge [color="#54e6c1", fontcolor="#9cb0a6", fontname="Arial", fontsize="9"];
  UI [label="Mission Control\nLive SSE + evidence ledger", color="#baff35"];
  API [label="Cloud Run · API\nBudgets + IDs-only events"];
  PS [label="Pub/Sub\nOIDC push · DLQ", shape=cylinder];
  R [label="Reader · ADK\nPDF + figures → claims"];
  P [label="Planner · ADK\nClaims → bounded plan"];
  C [label="Coder · Gemini\nPlan → immutable source"];
  E [label="Executor\nBuild · run · heal"];
  J [label="Cloud Run Jobs\nRestricted experiment", color="#ff9e57"];
  V [label="Verifier · Gemini Vision\nArtifacts → verdicts"];
  O [label="Reporter\nIAM-signed evidence report", color="#baff35"];
  F [label="Firestore\nState + repair memory", shape=cylinder];
  G [label="Cloud Storage\nPDF · code · logs · metrics · figures", shape=cylinder];
  T [label="Cloud Trace + Logging\nCorrelated audit trail", shape=cylinder];
  SM [label="Secret Manager\nExternal tokens", shape=cylinder];
  JAN [label="Scheduled Janitor\nStalled-run recovery"];
  UI -> API;
  API -> PS [label="replication.requested"];
  PS -> R -> P -> C -> E -> J -> V -> O;
  O -> UI [label="report.ready"];
  {R P C E V O JAN} -> F [color="#527466"];
  {R J O} -> G [color="#527466"];
  {R P C E V O} -> T [color="#527466"];
  SM -> C [style=dashed];
  JAN -> PS [label="dead-letter", style=dashed];
}
